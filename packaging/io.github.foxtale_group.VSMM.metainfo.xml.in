<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata. This is what GNOME Software, KDE Discover and similar read; they do
  not look at the RPM License tag or the .desktop file alone.

  Configured by CMake so the version comes from VSMM_RELEASE_VERSION rather than being a
  second place to update at release time.

  The component id is reverse-DNS per AppStream convention, derived from the GitHub org
  since the project has no domain. It deliberately does not match VSMM.desktop; the
  <launchable> tag below is what links the two, so the desktop file and icon keep their
  existing names and nothing about desktop integration changes.
-->
<component type="desktop-application">
  <id>io.github.foxtale_group.VSMM</id>
  <name>Vintage Story Mod Manager</name>
  <summary>Mod manager for Vintage Story</summary>

  <!-- Licence of this metadata file, which is separate from the licence of the program. -->
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="io.github.foxtale_group">
    <name>FoxTale Group - VSMM Team</name>
  </developer>

  <launchable type="desktop-id">VSMM.desktop</launchable>

  <description>
    <p>
      A fast and lightweight mod manager for Vintage Story, built with Qt 6. VSMM scans your
      local mods folder, cross-references each installed mod against the official Vintage
      Story mod API, and shows you at a glance which ones have updates waiting.
    </p>
    <p>
      Everything happens in one window: review what is installed, update what is out of
      date, add new mods from an archive, and start the game when you are done.
    </p>
    <ul>
      <li>See every installed mod with its version, author and tags</li>
      <li>Check for updates and install them individually or all at once</li>
      <li>Add mods from a local archive by browsing or drag and drop</li>
      <li>Remove mods and mark favourites</li>
      <li>Launch the game directly from the manager</li>
    </ul>
  </description>

  <categories>
    <category>Game</category>
    <category>Utility</category>
  </categories>

  <url type="homepage">https://github.com/FoxTale-Group/VSMM</url>
  <url type="bugtracker">https://github.com/FoxTale-Group/VSMM/issues</url>
  <url type="vcs-browser">https://github.com/FoxTale-Group/VSMM</url>

  <provides>
    <binary>VSMM</binary>
  </provides>

  <!-- No attributes means nothing objectionable. Software centres show an age rating and
       treat a missing rating as unknown, so an explicit empty one is better than none. -->
  <content_rating type="oars-1.1" />

  <releases>
    <!-- Release notes are generated by git-cliff after the package is built, so they cannot
         be embedded. The tag URL is predictable, so link to it instead: software centres
         render this as a "Details" link under the version. Tags carry a v prefix that
         VSMM_RELEASE_VERSION does not. -->
    <release version="@VSMM_RELEASE_VERSION@" date="@VSMM_RELEASE_DATE@">
      <url type="details">https://github.com/FoxTale-Group/VSMM/releases/tag/v@VSMM_RELEASE_VERSION@</url>
    </release>
  </releases>
</component>
