include($QT_INSTALL_DOCS/global/qt-html-templates-offline.qdocconf)

project = VSMM
description = Vintage Story Mod Manager developer reference
version = $VSMM_VERSION
buildversion = "VSMM $VSMM_VERSION Developer Reference"

navigation.homepage = index.html
navigation.hometitle = "VSMM"
navigation.cppclassespage = "VSMM C++ Classes"
navigation.qmltypespage = "VSMM QML Types"

# generated by docs/qdoc/CMakeLists.txt
moduleheader = VSMMDocs.hpp

headerdirs = ../../src
excludedirs = ../../src/tests ../../src/qml
sourcedirs = src

# use dark style instead of default light theme
HTML.headerstyles = \
    "  <link rel=\"stylesheet\" type=\"text/css\" href=\"style/offline-dark.css\" />\n"

HTML.footer = \
    "        </div>\n" \
    "       </div>\n" \
    "   </div>\n" \
    "   </div>\n" \
    "</div>\n" \
    "<div class=\"footer\">\n" \
    "   <p>VSMM is licensed under the GNU General Public License v3.0 or later.</p>\n" \
    "</div>\n"
